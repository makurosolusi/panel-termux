# Only these 4 are required. Everything else (Cloudflare, sites, backups) is set in /dev → Pengaturan.
# Public URL the panel is reached at (used for OAuth redirects). Must be an https domain or
# http://localhost:<port> — Google does not accept a bare/Tailscale IP. Local dev: http://localhost:3200
APP_BASE_URL=https://panel.example.com
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI to register: ${APP_BASE_URL}/api/auth/callback/google
#   e.g. https://panel.example.com/api/auth/callback/google
#   and for local dev: http://localhost:3200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become super_admin (re-synced on every sign-in and at boot).
# Any other Google account can sign in as `user`; a super_admin can make it `admin` in /dev → Pengguna.
SUPER_ADMIN_EMAILS=you@example.com
# Optional. The panel always listens on 127.0.0.1 only.
PORT=3200
# Holds panel.db and `secret` (encrypts stored setting secrets: back it up). Relative to the working dir.
PANEL_DATA_DIR=./data
