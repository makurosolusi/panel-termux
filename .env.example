# Public URL the panel is reached at (used for OAuth redirects).
APP_BASE_URL=https://panel.example.com
# Google OAuth client (console.cloud.google.com → Credentials).
# Authorized redirect URI to register: ${APP_BASE_URL}/api/auth/callback/google
#   e.g. https://panel.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get the super_admin role (re-synced on every sign-in and at boot).
# Everyone else must be invited (allowed_email table) or login fails with /login?error=not_invited.
SUPER_ADMIN_EMAILS=you@example.com
# Optional
PORT=3200
PANEL_DATA_DIR=./data
