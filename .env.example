# Public URL the panel is reached at (used for OAuth redirects).
APP_BASE_URL=https://panel.example.com
# Google OAuth client (console.cloud.google.com → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get the super_admin role.
SUPER_ADMIN_EMAILS=you@example.com
# Optional
PORT=3200
PANEL_DATA_DIR=./data
